        <mxCell id="title_erd_1" parent="1" style="html=1;text;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" value="&lt;div style=&quot;font-size:22px;font-weight:bold;color:#0f172a;letter-spacing:-0.5px;&quot;&gt;ENTITY RELATIONSHIP DIAGRAM (ERD) — PADU v1.02&lt;/div&gt;&#10;&lt;div style=&quot;font-size:13px;color:#475569;margin-top:5px;&quot;&gt;Sistem Pengolah &amp;amp; Analisis Data Terpadu (DTSEN 2026 Engine) — Skema Relasi Database Relasional (OLTP)&lt;/div&gt;" vertex="1">
