        <mxCell id="t_l2_p1" parent="1" style="html=1;text;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" value="&lt;div style=&quot;font-size:20px;font-weight:bold;color:#0f172a;&quot;&gt;DATA FLOW DIAGRAM (DFD) LEVEL 2 — PROSES 1.0 (TO-BE)&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#64748b;margin-top:4px;&quot;&gt;Dekomposisi Sub-Sistem Inisialisasi &amp;amp; Verifikasi Biometrik Awal (Headless OpenCV + MediaPipe)&lt;/div&gt;" vertex="1">
