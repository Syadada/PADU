        <mxCell id="1" parent="0" />
        <mxCell id="t_l2_p3_enh" value="&lt;div style=&quot;font-size:20px;font-weight:bold;color:#0f172a;&quot;&gt;DATA FLOW DIAGRAM (DFD) LEVEL 2 — PROSES 3.0 (TO-BE)&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#64748b;margin-top:4px;&quot;&gt;Dekomposisi Sub-Sistem Pemrosesan Analitik: Data Mikro (Transliterasi FK), PII Masking &amp;amp; Agregasi Wilayah (7 Metrik)&lt;/div&gt;" style="html=1;text;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="500" y="30" width="1200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="E1_L2_P3" value="&lt;div style=&quot;font-size:12px;color:#000000;font-weight:bold;&quot;&gt;ENTITAS LUAR&lt;/div&gt; &lt;div style=&quot;font-size:16px;font-weight:bold;margin-top:3px;color:#000000;&quot;&gt;OPERATOR DATA / ANALIS&lt;/div&gt; &lt;hr style=&quot;border:1px solid #007ACC;margin:10px 0;&quot;&gt; &lt;div style=&quot;text-align:left;font-size:11px;line-height:1.6;color:#000000;padding:0 8px;&quot;&gt; • Mengunggah berkas mentah DTSEN&lt;br&gt; • Memilih Modul: Data Mikro vs Statistik Wilayah&lt;br&gt; • Menjalankan filter dinamis &amp;amp; pencarian NIK/KK&lt;br&gt; • Meninjau data mikro terpadu (Transliterasi Label FK)&lt;br&gt; • Menganalisis agregasi wilayah (7 Metrik Statistik)&lt;br&gt; • Mengunduh paket ZIP arsip olahan &amp;amp; log audit&lt;br&gt; • Menerima notifikasi peringatan layar &lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#66B2FF;strokeColor=#007ACC;strokeWidth=2;fontColor=#000000;verticalAlign=middle;align=center;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="240" width="250" height="650" as="geometry" />
        </mxCell>
        <mxCell id="D2_L2_P3" value="&lt;b style=&quot;font-size:12px;color:#c084fc;&quot;&gt;D2&lt;/b&gt; | &lt;b&gt;Tabel Kolumnar (dtsen_data DuckDB)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#e9d5ff;&quot;&gt;Dataset 48 variabel ternormalisasi (Vector Pages)&lt;/span&gt;" style="shape=partialRectangle;right=0;left=0;html=1;fillColor=#3b0764;strokeColor=#c084fc;strokeWidth=2;fontColor=#ffffff;align=center;verticalAlign=middle;" vertex="1" parent="1">
