  <diagram name="TO-BE Level 2 - P6.0 (Terminasi &amp; Purge)" id="bwIgcdhJ2RZqRSjVLsci">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t_l2_p6" parent="1" style="html=1;text;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" value="&lt;div style=&quot;font-size:20px;font-weight:bold;color:#0f172a;&quot;&gt;DATA FLOW DIAGRAM (DFD) LEVEL 2 — PROSES 6.0 (TO-BE)&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#64748b;margin-top:4px;&quot;&gt;Dekomposisi Sub-Sistem Terminasi Sesi &amp;amp; Pembersihan Jejak Biometrik (Zero-Trace Purge)&lt;/div&gt;" vertex="1">
          <mxGeometry height="50" width="1050" x="450" y="30" as="geometry" />
        </mxCell>
        <mxCell id="E1_L2_P6" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#66B2FF;strokeColor=#007ACC;strokeWidth=2;fontColor=#000000;verticalAlign=middle;align=center;shadow=1;" value="&lt;div style=&quot;font-size: 12px; color: rgb(0, 0, 0); font-weight: bold;&quot;&gt;&lt;br&gt;&lt;/div&gt; &lt;div style=&quot;font-size: 16px; font-weight: bold; margin-top: 3px; color: rgb(0, 0, 0);&quot;&gt;OPERATOR DATA / ANALIS&lt;/div&gt; &lt;hr style=&quot;border: 1px solid rgb(0, 122, 204); margin: 10px 0px;&quot;&gt; &lt;div style=&quot;text-align: left; font-size: 11px; line-height: 1.6; color: rgb(0, 0, 0); padding: 0px 8px;&quot;&gt; • Mengunggah berkas mentah DTSEN&lt;br&gt; • Menjalankan filter dinamis &amp;amp; pencarian&lt;br&gt; • Meninjau tabel data ter-masking PII&lt;br&gt; • Menganalisis metrik kualitas data&lt;br&gt; • Mengunduh paket ZIP arsip &amp;amp; log audit&lt;br&gt; • Menerima notifikasi peringatan layar &lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="230" x="50" y="160" as="geometry" />
        </mxCell>
        <mxCell id="E3_L2_P6" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#66B2FF;strokeColor=#007ACC;strokeWidth=2;fontColor=#000000;verticalAlign=middle;align=center;shadow=1;" value="&lt;div style=&quot;font-size: 12px; color: rgb(0, 0, 0); font-weight: bold;&quot;&gt;&lt;br&gt;&lt;/div&gt; &lt;div style=&quot;font-size: 15px; font-weight: bold; margin-top: 2px; color: rgb(0, 0, 0);&quot;&gt;SISTEM OPERASI WINDOWS&lt;/div&gt; &lt;hr style=&quot;border: 1px solid rgb(0, 122, 204); margin: 8px 0px;&quot;&gt; &lt;div style=&quot;text-align: left; font-size: 11px; line-height: 1.5; color: rgb(0, 0, 0); padding: 0px 6px;&quot;&gt; • Windows API (user32.dll)&lt;br&gt; • Layar LockWorkStation (Win+L)&lt;br&gt; • Sinyal OS (SIGTERM / atexit) &lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="230" x="50" y="420" as="geometry" />
        </mxCell>
        <mxCell id="D4_L2_P6" parent="1" style="shape=partialRectangle;right=0;left=0;html=1;fillColor=#451a03;strokeColor=#f59e0b;strokeWidth=2;fontColor=#ffffff;align=center;verticalAlign=middle;" value="&lt;b style=&quot;font-size:12px;color:#f59e0b;&quot;&gt;D4&lt;/b&gt; | &lt;b&gt;Kredensial Sesi (sesi_wajah_aktif.jpg / RAM)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#fef08a;&quot;&gt;Snapshot file di RAM/disk yang harus dimusnahkan&lt;/span&gt;" vertex="1">
          <mxGeometry height="60" width="340" x="1200" y="290" as="geometry" />
        </mxCell>
        <mxCell id="P6_1" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#66B2FF;strokeColor=#007ACC;strokeWidth=2;fontColor=#000000;verticalAlign=middle;align=center;shadow=1;" value="&lt;div style=&quot;font-size:12px;color:#000000;font-weight:bold;&quot;&gt;6.1&lt;/div&gt; &lt;div style=&quot;font-size:13px;font-weight:bold;margin-top:2px;color:#000000;&quot;&gt;Termination Signal Interceptor&lt;/div&gt; &lt;hr style=&quot;border:1px solid #007ACC;margin:5px 0;&quot;&gt; &lt;div style=&quot;font-size:10px;text-align:left;line-height:1.4;color:#000000;&quot;&gt; • Tangkap event tutup browser (window.onbeforeunload)&lt;br&gt; • Tangkap handler python atexit / SIGTERM&lt;br&gt; • Cegah proses terminasi sebelum cleanup selesai &lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="270" x="360" y="290" as="geometry" />
        </mxCell>
        <mxCell id="P6_2" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#66B2FF;strokeColor=#007ACC;strokeWidth=2;fontColor=#000000;verticalAlign=middle;align=center;shadow=1;" value="&lt;div style=&quot;font-size:12px;color:#000000;font-weight:bold;&quot;&gt;6.2&lt;/div&gt; &lt;div style=&quot;font-size:13px;font-weight:bold;margin-top:2px;color:#000000;&quot;&gt;Resource &amp;amp; Hardware Teardown&lt;/div&gt; &lt;hr style=&quot;border:1px solid #007ACC;margin:5px 0;&quot;&gt; &lt;div style=&quot;font-size:10px;text-align:left;line-height:1.4;color:#000000;&quot;&gt; • cv2.VideoCapture.release() (Lepas kamera)&lt;br&gt; • Tutup koneksi &amp;amp; cursor DuckDB database&lt;br&gt; • Matikan thread background guard loop &lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="270" x="700" y="290" as="geometry" />
        </mxCell>
        <mxCell id="P6_3" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#66B2FF;strokeColor=#007ACC;strokeWidth=2;fontColor=#000000;verticalAlign=middle;align=center;shadow=1;" value="&lt;div style=&quot;font-size:12px;color:#000000;font-weight:bold;&quot;&gt;6.3&lt;/div&gt; &lt;div style=&quot;font-size:13px;font-weight:bold;margin-top:2px;color:#000000;&quot;&gt;Cryptographic Byte Overwrite (0x00)&lt;/div&gt; &lt;hr style=&quot;border:1px solid #007ACC;margin:5px 0;&quot;&gt; &lt;div style=&quot;font-size:10px;text-align:left;line-height:1.4;color:#000000;&quot;&gt; • Buka sesi_wajah_aktif.jpg mode r+b&lt;br&gt; • Tuliskan byte 0x00 sebanyak ukuran file penuh&lt;br&gt; • Flush buffer disk I/O seketika &lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="270" x="1040" y="170" as="geometry" />
        </mxCell>
        <mxCell id="P6_4" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#66B2FF;strokeColor=#007ACC;strokeWidth=2;fontColor=#000000;verticalAlign=middle;align=center;shadow=1;" value="&lt;div style=&quot;font-size:12px;color:#000000;font-weight:bold;&quot;&gt;6.4&lt;/div&gt; &lt;div style=&quot;font-size:13px;font-weight:bold;margin-top:2px;color:#000000;&quot;&gt;File Unlink &amp;amp; RAM Cache Purge&lt;/div&gt; &lt;hr style=&quot;border:1px solid #007ACC;margin:5px 0;&quot;&gt; &lt;div style=&quot;font-size:10px;text-align:left;line-height:1.4;color:#000000;&quot;&gt; • os.unlink(sesi_wajah_aktif.jpg) (Hapus permanen)&lt;br&gt; • Garbage collection paksa untuk clear RAM memory&lt;br&gt; • Jaminan Zero-Trace (Tanpa jejak biometrik tersisa) &lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="270" x="1040" y="390" as="geometry" />
        </mxCell>
