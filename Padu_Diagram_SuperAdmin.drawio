        </mxCell>
        <mxCell id="E2_L2_P4" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#66B2FF;strokeColor=#007ACC;strokeWidth=2;fontColor=#000000;verticalAlign=middle;align=center;shadow=1;" value="&lt;div style=&quot;font-size: 12px; color: rgb(0, 0, 0); font-weight: bold;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(237, 237, 237)); font-size: 15px; background-color: transparent;&quot;&gt;SENSOR KAMERA / WEBCAM&lt;/span&gt;&lt;/div&gt; &lt;hr style=&quot;border: 1px solid rgb(0, 122, 204); margin: 8px 0px;&quot;&gt; &lt;div style=&quot;text-align: left; font-size: 11px; line-height: 1.5; color: rgb(0, 0, 0); padding: 0px 6px;&quot;&gt; • Headless OpenCV Capture (DSHOW)&lt;br&gt; • Frame visual berkala (loop 0.2s)&lt;br&gt; • Snapshot verifikasi biometrik &lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="230" x="50" y="220" as="geometry" />
        </mxCell>
        <mxCell id="D4_L2_P4" parent="1" style="shape=partialRectangle;right=0;left=0;html=1;fillColor=#451a03;strokeColor=#f59e0b;strokeWidth=2;fontColor=#ffffff;align=center;verticalAlign=middle;" value="&lt;b style=&quot;font-size:12px;color:#f59e0b;&quot;&gt;D4&lt;/b&gt; | &lt;b&gt;Kredensial Sesi (sesi_wajah_aktif.jpg / RAM)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#fef08a;&quot;&gt;Profil geometri wajah pemilik sah sesi aktif&lt;/span&gt;" vertex="1">
          <mxGeometry height="55" width="340" x="720" y="90" as="geometry" />
        </mxCell>
        <mxCell id="E3_L2_P4" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#66B2FF;strokeColor=#007ACC;strokeWidth=2;fontColor=#000000;verticalAlign=middle;align=center;shadow=1;" value="&lt;div style=&quot;font-size: 12px; color: rgb(0, 0, 0); font-weight: bold;&quot;&gt;&lt;br&gt;&lt;/div&gt; &lt;div style=&quot;font-size: 15px; font-weight: bold; margin-top: 2px; color: rgb(0, 0, 0);&quot;&gt;SISTEM OPERASI WINDOWS&lt;/div&gt; &lt;hr style=&quot;border: 1px solid rgb(0, 122, 204); margin: 8px 0px;&quot;&gt; &lt;div style=&quot;text-align: left; font-size: 11px; line-height: 1.5; color: rgb(0, 0, 0); padding: 0px 6px;&quot;&gt; • Windows API (user32.dll)&lt;br&gt; • Layar LockWorkStation (Win+L)&lt;br&gt; • Sinyal OS (SIGTERM / atexit) &lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="230" x="1450" y="180" as="geometry" />
        </mxCell>
        <mxCell id="E1_L2_P4" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#66B2FF;strokeColor=#007ACC;strokeWidth=2;fontColor=#000000;verticalAlign=middle;align=center;shadow=1;" value="&lt;div style=&quot;font-size: 12px; color: rgb(0, 0, 0); font-weight: bold;&quot;&gt;&lt;br&gt;&lt;/div&gt; &lt;div style=&quot;font-size: 16px; font-weight: bold; margin-top: 3px; color: rgb(0, 0, 0);&quot;&gt;OPERATOR DATA / ANALIS&lt;/div&gt; &lt;hr style=&quot;border: 1px solid rgb(0, 122, 204); margin: 10px 0px;&quot;&gt; &lt;div style=&quot;text-align: left; font-size: 11px; line-height: 1.6; color: rgb(0, 0, 0); padding: 0px 8px;&quot;&gt; • Mengunggah berkas mentah DTSEN&lt;br&gt; • Menjalankan filter dinamis &amp;amp; pencarian&lt;br&gt; • Meninjau tabel data ter-masking PII&lt;br&gt; • Menganalisis metrik kualitas data&lt;br&gt; • Mengunduh paket ZIP arsip &amp;amp; log audit&lt;br&gt; • Menerima notifikasi peringatan layar &lt;/div&gt;" vertex="1">
          <mxGeometry height="240" width="230" x="1450" y="420" as="geometry" />
        </mxCell>
        <mxCell id="P4_1" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#66B2FF;strokeColor=#007ACC;strokeWidth=2;fontColor=#000000;verticalAlign=middle;align=center;shadow=1;" value="&lt;div style=&quot;font-size:12px;color:#000000;font-weight:bold;&quot;&gt;4.1&lt;/div&gt; &lt;div style=&quot;font-size:13px;font-weight:bold;margin-top:2px;color:#000000;&quot;&gt;Polling Frame Loop 0.2s (OpenCV)&lt;/div&gt; &lt;hr style=&quot;border:1px solid #007ACC;margin:5px 0;&quot;&gt; &lt;div style=&quot;font-size:10px;text-align:left;line-height:1.4;color:#000000;&quot;&gt; • Polling periodik non-blocking setiap 200ms&lt;br&gt; • Beban CPU sangat ringan (&amp;lt; 3%)&lt;br&gt; • Stream frame RGB ke pipeline evaluasi &lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="260" x="340" y="240" as="geometry" />
        </mxCell>
        <mxCell id="P4_2" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#66B2FF;strokeColor=#007ACC;strokeWidth=2;fontColor=#000000;verticalAlign=middle;align=center;shadow=1;" value="&lt;div style=&quot;font-size:12px;color:#000000;font-weight:bold;&quot;&gt;4.2&lt;/div&gt; &lt;div style=&quot;font-size:13px;font-weight:bold;margin-top:2px;color:#000000;&quot;&gt;Iris Tracking &amp;amp; Face Matcher&lt;/div&gt; &lt;hr style=&quot;border:1px solid #007ACC;margin:5px 0;&quot;&gt; &lt;div style=&quot;font-size:10px;text-align:left;line-height:1.4;color:#000000;&quot;&gt; • Deteksi orientasi pandangan mata (gaze)&lt;br&gt; • Komparasi kemiripan terhadap D4 baseline&lt;br&gt; • Klasifikasi status visual frame aktif &lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="280" x="720" y="240" as="geometry" />
        </mxCell>
        <mxCell id="P4_3" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#66B2FF;strokeColor=#007ACC;strokeWidth=2;fontColor=#000000;verticalAlign=middle;align=center;shadow=1;" value="&lt;div style=&quot;font-size:12px;color:#000000;font-weight:bold;&quot;&gt;4.3&lt;/div&gt; &lt;div style=&quot;font-size:13px;font-weight:bold;margin-top:2px;color:#000000;&quot;&gt;Absence Detector (User Pergi &amp;gt; 4s)&lt;/div&gt; &lt;hr style=&quot;border:1px solid #007ACC;margin:5px 0;&quot;&gt; &lt;div style=&quot;font-size:10px;text-align:left;line-height:1.4;color:#000000;&quot;&gt; • Deteksi 0 wajah pada frame berkala&lt;br&gt; • Stopwatch delta waktu ketidakhadiran&lt;br&gt; • Trigger lockout jika durasi &amp;gt; 4.0 detik &lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="270" x="1080" y="180" as="geometry" />
        </mxCell>
        <mxCell id="P4_4" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#66B2FF;strokeColor=#007ACC;strokeWidth=2;fontColor=#000000;verticalAlign=middle;align=center;shadow=1;" value="&lt;div style=&quot;font-size:12px;color:#000000;font-weight:bold;&quot;&gt;4.4&lt;/div&gt; &lt;div style=&quot;font-size:13px;font-weight:bold;margin-top:2px;color:#000000;&quot;&gt;Shoulder Surfing Detector (Asing &amp;gt; 1s)&lt;/div&gt; &lt;hr style=&quot;border:1px solid #007ACC;margin:5px 0;&quot;&gt; &lt;div style=&quot;font-size:10px;text-align:left;line-height:1.4;color:#000000;&quot;&gt; • Deteksi kemunculan wajah kedua / asing&lt;br&gt; • Evaluasi tatapan mata asing mengintip ke layar&lt;br&gt; • Trigger lockout instan jika durasi &amp;gt; 1.0 detik &lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="270" x="1080" y="320" as="geometry" />
        </mxCell>
        <mxCell id="P4_5" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#66B2FF;strokeColor=#007ACC;strokeWidth=2;fontColor=#000000;verticalAlign=middle;align=center;shadow=1;" value="&lt;div style=&quot;font-size:12px;color:#000000;font-weight:bold;&quot;&gt;4.5&lt;/div&gt; &lt;div style=&quot;font-size:13px;font-weight:bold;margin-top:2px;color:#000000;&quot;&gt;Security Actuator &amp;amp; Lockdown Controller&lt;/div&gt; &lt;hr style=&quot;border:1px solid #007ACC;margin:5px 0;&quot;&gt; &lt;div style=&quot;font-size:10px;text-align:left;line-height:1.4;color:#000000;&quot;&gt; • Eksekusi API user32.LockWorkStation (Win+L)&lt;br&gt; • Tampilkan overlay Red Lock &amp;amp; Blur UI&lt;br&gt; • Freeze seluruh interaksi data secara instan &lt;/div&gt;" vertex="1">
