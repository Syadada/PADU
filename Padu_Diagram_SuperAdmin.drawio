        <mxCell id="t_sa_1" parent="1" style="html=1;text;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" value="&lt;div style=&quot;font-size:20px;font-weight:bold;color:#0f172a;&quot;&gt;DATA FLOW DIAGRAM (DFD) LEVEL 1 — TO-BE DENGAN SUPER ADMIN&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#64748b;margin-top:4px;&quot;&gt;Pemetaan 7 Sub-Proses Fungsional Berurutan (1.0 s/d 7.0), 7 Data Store, dan 4 Entitas Eksternal (Termasuk Tata Kelola Library)&lt;/div&gt;" vertex="1">
