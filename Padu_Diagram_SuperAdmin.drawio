        </mxCell>
        <mxCell id="E4_SA_1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fef08a;strokeColor=#ca8a04;strokeWidth=2.5;fontColor=#000000;verticalAlign=middle;align=center;shadow=1;" value="&lt;div style=&quot;font-size:12px;color:#000000;font-weight:bold;&quot;&gt;ENTITAS LUAR KHUSUS&lt;/div&gt; &lt;div style=&quot;font-size:16px;font-weight:bold;margin-top:3px;color:#000000;&quot;&gt;👑 SUPER ADMIN (BAPPENAS / BPS)&lt;/div&gt; &lt;hr style=&quot;border:1px solid #007ACC;margin:10px 0;&quot;&gt; &lt;div style=&quot;text-align:left;font-size:11px;line-height:1.6;color:#000000;padding:0 8px;&quot;&gt; • Mengakses Dedicated Library Management Page&lt;br&gt; • Memperbarui Kamus Kode Referensi (Bappenas)&lt;br&gt; • Mengatur Aturan Kualitas &amp;amp; Variabel Baru&lt;br&gt; • Mengontrol Hak Akses &amp;amp; Manajemen Pengguna&lt;br&gt; • Mengaudit Log Perubahan Master Metadata &lt;/div&gt;" vertex="1">
          <mxGeometry height="250" width="290" x="2750" y="240" as="geometry" />
        </mxCell>
        <mxCell id="E2_SA_1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#66B2FF;strokeColor=#007ACC;strokeWidth=2;fontColor=#000000;verticalAlign=middle;align=center;shadow=1;" value="&lt;div style=&quot;font-size:12px;color:#000000;font-weight:bold;&quot;&gt;ENTITAS LUAR&lt;/div&gt; &lt;div style=&quot;font-size:15px;font-weight:bold;margin-top:2px;color:#000000;&quot;&gt;SENSOR KAMERA / WEBCAM&lt;/div&gt; &lt;hr style=&quot;border:1px solid #007ACC;margin:8px 0;&quot;&gt; &lt;div style=&quot;text-align:left;font-size:11px;line-height:1.5;color:#000000;padding:0 6px;&quot;&gt; • Headless OpenCV Capture (DSHOW)&lt;br&gt; • Frame visual berkala (loop 0.2s)&lt;br&gt; • Snapshot verifikasi biometrik &lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="260" x="350" y="90" as="geometry" />
