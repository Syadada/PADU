        <mxCell id="E3_SA_1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#66B2FF;strokeColor=#007ACC;strokeWidth=2;fontColor=#000000;verticalAlign=middle;align=center;shadow=1;" value="&lt;div style=&quot;font-size:12px;color:#000000;font-weight:bold;&quot;&gt;ENTITAS LUAR&lt;/div&gt; &lt;div style=&quot;font-size:15px;font-weight:bold;margin-top:2px;color:#000000;&quot;&gt;SISTEM OPERASI WINDOWS&lt;/div&gt; &lt;hr style=&quot;border:1px solid #007ACC;margin:8px 0;&quot;&gt; &lt;div style=&quot;text-align:left;font-size:11px;line-height:1.5;color:#000000;padding:0 6px;&quot;&gt; • Windows API (user32.dll)&lt;br&gt; • Layar LockWorkStation (Win+L)&lt;br&gt; • Sinyal OS (SIGTERM / atexit) &lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="260" x="2350" y="90" as="geometry" />
        </mxCell>
        <mxCell id="D1_SA" parent="1" style="shape=partialRectangle;right=0;left=0;html=1;fillColor=#0f172a;strokeColor=#38bdf8;strokeWidth=2;fontColor=#ffffff;align=center;verticalAlign=middle;" value="&lt;b style=&quot;font-size:12px;color:#38bdf8;&quot;&gt;D1&lt;/b&gt; | &lt;b&gt;Folder Sumber DTSEN (src-dtsen/)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#94a3b8;&quot;&gt;File mentah CSV / XLSX (13M+ baris)&lt;/span&gt;" vertex="1">
