  <diagram name="TO-BE Level 2 - P4.0 (Guard Loop &amp; Anti-Surfing)" id="jMNiBaCoA0x5pWxrQvvd">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1850" pageHeight="1000" math="0" shadow="0">
