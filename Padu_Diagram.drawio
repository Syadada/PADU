        <mxCell id="e_tb_0_7" value="7. Tab 2: Rekap 7 Metrik Statistik Regional" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#059669;strokeWidth=2;fontColor=#047857;fontSize=10;fontStyle=1;labelBackgroundColor=#ecfdf5;labelBorderColor=#a7f3d0;exitX=0;exitY=0.90;entryX=1;entryY=0.90;" edge="1" parent="1" source="P0_TOBE" target="E1_TOBE_0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_tb_0_8" value="8. Paket Arsip ZIP (Clean/Error CSV + SHA-256)" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#059669;strokeWidth=2;fontColor=#047857;fontSize=10;fontStyle=1;labelBackgroundColor=#ecfdf5;labelBorderColor=#a7f3d0;exitX=0;exitY=0.97;entryX=1;entryY=0.97;" edge="1" parent="1" source="P0_TOBE" target="E1_TOBE_0">
