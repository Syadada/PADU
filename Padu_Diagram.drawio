          <mxGeometry height="50" width="950" x="450" y="30" as="geometry" />
        </mxCell>
        <mxCell id="E2_L2_P1" parent="1" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#66B2FF;strokeColor=#007ACC;strokeWidth=2;fontColor=#000000;verticalAlign=middle;align=center;shadow=1;" value="&lt;div style=&quot;font-size: 12px; color: rgb(0, 0, 0); font-weight: bold;&quot;&gt;&lt;br&gt;&lt;/div&gt; &lt;div style=&quot;font-size: 15px; font-weight: bold; margin-top: 2px; color: rgb(0, 0, 0);&quot;&gt;SENSOR KAMERA / WEBCAM&lt;/div&gt; &lt;hr style=&quot;border: 1px solid rgb(0, 122, 204); margin: 8px 0px;&quot;&gt; &lt;div style=&quot;text-align: left; font-size: 11px; line-height: 1.5; color: rgb(0, 0, 0); padding: 0px 6px;&quot;&gt; • Headless OpenCV Capture (DSHOW)&lt;br&gt; • Frame visual berkala (loop 0.2s)&lt;br&gt; • Snapshot verifikasi biometrik &lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="230" x="60" y="220" as="geometry" />
