    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t_l2_p6" parent="1" style="html=1;text;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" value="&lt;div style=&quot;font-size:20px;font-weight:bold;color:#0f172a;&quot;&gt;DATA FLOW DIAGRAM (DFD) LEVEL 2 — PROSES 6.0 (TO-BE)&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#64748b;margin-top:4px;&quot;&gt;Dekomposisi Sub-Sistem Terminasi Sesi &amp;amp; Pembersihan Jejak Biometrik (Zero-Trace Purge)&lt;/div&gt;" vertex="1">
