        <diagram id="dfd_tobe_level_0" name="TO-BE Level 0 (Diagram Konteks)">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t_tobe_0" value="&lt;div style=&quot;font-size:18px;font-weight:bold;color:#0f172a;&quot;&gt;DATA FLOW DIAGRAM (DFD) LEVEL 0 — TO-BE (DIAGRAM KONTEKS)&lt;/div&gt;&lt;div style=&quot;font-size:13px;color:#64748b;margin-top:4px;&quot;&gt;Sistem Analisis Data Terpadu &amp;amp; Analitik Regional (PADU v2.0 Enterprise — Clean Web App)&lt;/div&gt;" style="html=1;text;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="300" y="40" width="800" height="50" as="geometry" />
        </mxCell>
        <mxCell id="P0_TOBE" value="&lt;div style=&quot;font-size:14px;color:#000000;font-weight:bold;&quot;&gt;0.0&lt;/div&gt;
&lt;div style=&quot;font-size:16px;font-weight:bold;margin-top:4px;color:#000000;&quot;&gt;SISTEM ANALISIS DATA DTSEN &amp;amp;&lt;br/&gt;ANALITIK REGIONAL (CLEAN WEB)&lt;/div&gt;
&lt;div style=&quot;font-size:12px;font-weight:bold;color:#004080;margin-top:2px;&quot;&gt;(PADU v2.0 Enterprise)&lt;/div&gt;
&lt;hr style=&quot;border:1px solid #007ACC;margin:10px 0;&quot;&gt;
&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.5;color:#000000;padding:0 12px;&quot;&gt;
• Otentikasi Web Dua Tahap (Two-Step Email-First Login)&lt;br/&gt;
• Kebijakan Kata Sandi Minimal 15 Karakter (NIST / BSSN)&lt;br/&gt;
• Ingesti Cepat Chunking PyArrow &amp;gt; 1,5 Juta Baris/Detik&lt;br/&gt;
• Engine Evaluasi Kualitas Data &amp;amp; Rekam Anomali&lt;br/&gt;
• Tab 1: Data Mikro Terpadu (Dynamic PII Masking &amp;amp; FK Transliterasi)&lt;br/&gt;
• Tab 2: Data Statistik Regional (Kalkulasi 7 Metrik Agregasi)&lt;br/&gt;
• Ekspor Paket Arsip ZIP Terkompresi (DEFLATE + SHA-256)
&lt;/div&gt;" style="shape=ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;strokeColor=#007ACC;strokeWidth=3;fontColor=#000000;align=center;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="160" width="460" height="460" as="geometry" />
        </mxCell>
        <mxCell id="E1_TOBE_0" value="&lt;div style=&quot;font-size:12px;color:#000000;font-weight:bold;&quot;&gt;ENTITAS LUAR (EXTERNAL ENTITY)&lt;/div&gt;
&lt;div style=&quot;font-size:15px;font-weight:bold;margin-top:2px;color:#000000;&quot;&gt;👤 OPERATOR DATA / ANALIS&lt;/div&gt;
&lt;hr style=&quot;border:1px solid #007ACC;margin:8px 0;&quot;&gt;
&lt;div style=&quot;text-align:left;font-size:11px;line-height:1.6;color:#000000;padding:0 8px;&quot;&gt;
• Otentikasi Kredensial Pengguna Standar BSSN&lt;br/&gt;
• Mengunggah berkas mentah DTSEN ke src-dtsen/&lt;br/&gt;
• Memilih Modul: Data Mikro vs Statistik Wilayah&lt;br/&gt;
• Menjalankan filter dinamis &amp;amp; pencarian NIK/KK&lt;br/&gt;
• Meninjau data mikro terpadu (Transliterasi Label FK)&lt;br/&gt;
• Menganalisis agregasi wilayah (7 Metrik Statistik)&lt;br/&gt;
• Mengunduh paket ZIP arsip olahan &amp;amp; log audit
&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#66B2FF;strokeColor=#007ACC;strokeWidth=2;fontColor=#000000;verticalAlign=middle;align=center;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="180" width="300" height="420" as="geometry" />
        </mxCell>
        <mxCell id="e_tb_0_1" value="1. Kredensial Login (Email &amp;amp; Password Min 15 Char)" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#0284c7;strokeWidth=2;fontColor=#0369a1;fontSize=10;fontStyle=1;labelBackgroundColor=#f0f9ff;labelBorderColor=#bae6fd;exitX=1;exitY=0.15;entryX=0;entryY=0.15;" edge="1" parent="1" source="E1_TOBE_0" target="P0_TOBE">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_tb_0_2" value="2. Berkas Mentah DTSEN (CSV / XLSX 13M+ Baris)" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#0284c7;strokeWidth=2;fontColor=#0369a1;fontSize=10;fontStyle=1;labelBackgroundColor=#f0f9ff;labelBorderColor=#bae6fd;exitX=1;exitY=0.30;entryX=0;entryY=0.30;" edge="1" parent="1" source="E1_TOBE_0" target="P0_TOBE">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_tb_0_3" value="3. Parameter Filter Dinamis &amp;amp; Pilihan Modul" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#0284c7;strokeWidth=2;fontColor=#0369a1;fontSize=10;fontStyle=1;labelBackgroundColor=#f0f9ff;labelBorderColor=#bae6fd;exitX=1;exitY=0.45;entryX=0;entryY=0.45;" edge="1" parent="1" source="E1_TOBE_0" target="P0_TOBE">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_tb_0_4" value="4. Permintaan Unduh Paket Arsip ZIP" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#0284c7;strokeWidth=2;fontColor=#0369a1;fontSize=10;fontStyle=1;labelBackgroundColor=#f0f9ff;labelBorderColor=#bae6fd;exitX=1;exitY=0.60;entryX=0;entryY=0.60;" edge="1" parent="1" source="E1_TOBE_0" target="P0_TOBE">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_tb_0_5" value="5. Sesi Valid HttpOnly &amp;amp; Progress Status Ingesti" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#059669;strokeWidth=2;fontColor=#047857;fontSize=10;fontStyle=1;labelBackgroundColor=#ecfdf5;labelBorderColor=#a7f3d0;exitX=0;exitY=0.72;entryX=1;entryY=0.72;" edge="1" parent="1" source="P0_TOBE" target="E1_TOBE_0">
