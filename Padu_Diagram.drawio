        <mxCell id="e_tb_0_6" value="6. Tab 1: Data Mikro Terpadu (PII-Masked &amp;amp; Label FK)" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;strokeColor=#059669;strokeWidth=2;fontColor=#047857;fontSize=10;fontStyle=1;labelBackgroundColor=#ecfdf5;labelBorderColor=#a7f3d0;exitX=0;exitY=0.82;entryX=1;entryY=0.82;" edge="1" parent="1" source="P0_TOBE" target="E1_TOBE_0">
