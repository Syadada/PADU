          <mxGeometry height="110" width="270" x="360" y="290" as="geometry" />
        </mxCell>
        <mxCell id="P6_2" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#66B2FF;strokeColor=#007ACC;strokeWidth=2;fontColor=#000000;verticalAlign=middle;align=center;shadow=1;" value="&lt;div style=&quot;font-size:12px;color:#000000;font-weight:bold;&quot;&gt;6.2&lt;/div&gt; &lt;div style=&quot;font-size:13px;font-weight:bold;margin-top:2px;color:#000000;&quot;&gt;Resource &amp;amp; Hardware Teardown&lt;/div&gt; &lt;hr style=&quot;border:1px solid #007ACC;margin:5px 0;&quot;&gt; &lt;div style=&quot;font-size:10px;text-align:left;line-height:1.4;color:#000000;&quot;&gt; • cv2.VideoCapture.release() (Lepas kamera)&lt;br&gt; • Tutup koneksi &amp;amp; cursor DuckDB database&lt;br&gt; • Matikan thread background guard loop &lt;/div&gt;" vertex="1">
